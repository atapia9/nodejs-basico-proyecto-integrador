# Copia este archivo como .env y completa los valores. El archivo .env NO se sube a Git.
# Una variable vacía usa su valor por defecto (entre paréntesis).

# Puerto en el que escucha el servidor (3000)
PORT=

# Ruta del archivo SQLite (./data/biblioteca.sqlite)
DB_FILE=

# Si tiene valor, las rutas que modifican datos exigen el header x-api-key con ese mismo valor.
# Si queda vacía, no se exige API key.
API_KEY=
