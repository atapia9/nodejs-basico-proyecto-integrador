data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db

# Registros y archivos del sistema
npm-debug.log*
.DS_Store
Thumbs.db

# Material del instructor (manual y evaluación con clave de respuestas); no es parte de la plantilla
fuentes/
